<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow cleartext (http) traffic app-wide to fix ERR_CLEARTEXT_NOT_PERMITTED -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
